PORT=2567

# LOCAL TESTING ONLY — never set this in a deployed environment (DEPLOY.md's
# instructions never set it). Skips real Supabase JWT verification (accepts a plain
# dev:<id>:<name> token) and swaps Postgres for an in-memory chip store, so the whole
# join/admit/start/play loop can be tested with zero external accounts. See
# server/src/auth.ts and server/src/db.ts. The client's matching flag is
# EXPO_PUBLIC_DEV_MODE (see .env.example at the repo root).
DEV_MODE=false

# Supabase Project URL (Project Settings > API > Project URL — same value as the
# client's EXPO_PUBLIC_SUPABASE_URL). Used to verify each client's access token
# against the project's public JWKS endpoint (new projects sign auth tokens
# asymmetrically by default — there's no shared secret to copy for these).
SUPABASE_URL=https://your-project.supabase.co

# Legacy fallback ONLY — leave unset if SUPABASE_URL is set above. Only exists for
# older Supabase projects still on symmetric (HS256) JWT signing, where a shared
# secret is available under Project Settings > API > JWT Settings.
SUPABASE_JWT_SECRET=

# Supabase Project Settings > Database > Connection string (use the "Session" pooler
# or direct connection — NOT the anon/public one). This must be a connection that can
# write to public.users/chip_ledger/hands, i.e. the postgres role or one with
# equivalent grants; RLS is bypassed for direct Postgres connections by default only
# for the postgres/service roles — do not use the anon key here, it's not a DB
# connection string at all.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
